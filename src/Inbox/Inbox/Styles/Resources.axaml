<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The talk's night palette, with .NET purple for what the person can act on. -->
  <SolidColorBrush x:Key="NightBrush" Color="#0E0C19" />
  <SolidColorBrush x:Key="PaneBrush" Color="#15122A" />
  <SolidColorBrush x:Key="RaisedBrush" Color="#1E1A38" />
  <SolidColorBrush x:Key="SelectedBrush" Color="#2A2252" />
  <SolidColorBrush x:Key="HoverBrush" Color="#1F1A3A" />
  <SolidColorBrush x:Key="LineBrush" Color="#2B2648" />
  <SolidColorBrush x:Key="TextBrush" Color="#F2F0FA" />
  <SolidColorBrush x:Key="MutedBrush" Color="#9A93B8" />
  <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFF" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#6646F0" />
  <!-- The accent lightened for text and thin lines, so they read on the dark background. -->
  <SolidColorBrush x:Key="LinkBrush" Color="#A996FF" />

  <!-- The back chevron, an open path for a stroke. -->
  <StreamGeometry x:Key="ChevronLeft">M9,1 L1,9 L9,17</StreamGeometry>

  <!-- Lucide-style line icons, on a 24-unit grid: open outlines for a stroke, except send, which is filled. -->
  <StreamGeometry x:Key="SearchIcon">M11,3 A8,8 0 1 1 10.99,3 Z M21,21 L16.65,16.65</StreamGeometry>
  <StreamGeometry x:Key="SendIcon">M22,2 L11,13 M22,2 L15,22 L11,13 L2,9 Z</StreamGeometry>
  <StreamGeometry x:Key="MailIcon">M3,6 C3,4.9 3.9,4 5,4 L19,4 C20.1,4 21,4.9 21,6 L21,18 C21,19.1 20.1,20 19,20 L5,20 C3.9,20 3,19.1 3,18 Z M3,7 L12,13 L21,7</StreamGeometry>

</ResourceDictionary>
