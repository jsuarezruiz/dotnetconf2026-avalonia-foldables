<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Text -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.from">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.time">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.subject">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.preview">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <!-- Up to three lines: rows grow and shrink with the list's width, so a fold moves everything below. -->
    <Setter Property="MaxLines" Value="3" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.headline">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- A sender's initials in a colored circle. -->
  <Style Selector="Border.avatar">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.avatar > TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The message list: rows as rounded cards, the open one highlighted. -->
  <Style Selector="ListBox.mail">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,0,8,12" />
  </Style>
  <Style Selector="ListBox.mail ListBoxItem">
    <Setter Property="Padding" Value="12,12" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="ListBox.mail ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
  </Style>
  <Style Selector="ListBox.mail ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
  </Style>
  <Style Selector="ListBox.mail ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
  </Style>
  <Style Selector="ListBox.mail ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Back, as a navigation bar's: the chevron and where it goes, in the accent color, no box around it,
       dimmed while pressed. -->
  <Style Selector="Button.back">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,0,14,0" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.back:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.back:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.back:pressed">
    <Setter Property="Opacity" Value="0.4" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>
  <Style Selector="Button.back Path">
    <Setter Property="Stroke" Value="{StaticResource LinkBrush}" />
    <Setter Property="StrokeThickness" Value="2.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="19" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.back TextBlock">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Foreground" Value="{StaticResource LinkBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Round icon buttons: send. -->
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="Button.send">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Button.send:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
  </Style>
  <Style Selector="Button.send:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource LineBrush}" />
  </Style>

  <!-- Line icons: an outline drawn with a stroke. -->
  <Style Selector="Path.line">
    <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>

  <!-- Search: a pill with a magnifier, above the list. -->
  <Style Selector="TextBox.search">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="8,9,10,9" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
  </Style>

  <!-- The reply box: a pill that grows with the reply. -->
  <Style Selector="TextBox.reply">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Padding" Value="16,11" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MaxHeight" Value="160" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.reply:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="TextBox.reply:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
  </Style>

</Styles>
