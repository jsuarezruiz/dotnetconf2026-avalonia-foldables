<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:BotVsBugs.Controls"
             x:Class="BotVsBugs.Controls.ControlDeck"
             Background="{StaticResource NightBrush}">

  <!-- The half of the device lying on the table in tabletop: the hinge gauge, the aim and the score. -->
  <Grid RowDefinitions="Auto,*,Auto" Margin="16,12,16,14">

    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="eyebrow" Text="HINGE SLINGSHOT" />
        <TextBlock Name="LevelText" Classes="hud" FontSize="20" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock Classes="eyebrow" Text="SCORE" HorizontalAlignment="Right" />
        <TextBlock Name="ScoreText"
                   Classes="hud"
                   FontSize="20"
                   HorizontalAlignment="Right"
                   Foreground="{StaticResource SunBrush}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,10">
      <Border Classes="card">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Classes="eyebrow" Text="FOLD TO PULL, OPEN TO FIRE" />
          <controls:HingeGauge Name="Gauge" Grid.Row="1" AutomationProperties.Name="Hinge gauge" />
        </Grid>
      </Border>
      <Border Grid.Column="1" Classes="card" Margin="10,0,0,0">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Classes="eyebrow" Text="DRAG TO AIM" />
          <controls:AimDial Name="Dial" Grid.Row="1" AutomationProperties.Name="Aim dial" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <TextBlock Name="StatusText" Classes="body" VerticalAlignment="Center" />
      <Button Name="PauseButton" Grid.Column="1" Classes="icon" AutomationProperties.Name="Pause">
        <Path Data="M0,0 H4 V14 H0 Z M8,0 H12 V14 H8 Z" Fill="White" />
      </Button>
    </Grid>

  </Grid>
</UserControl>
