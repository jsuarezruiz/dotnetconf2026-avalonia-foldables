<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The demos use the Nova.Avalonia.Foldable packages from NuGet. Pass NovaFoldableRoot, the path to a checkout of
       the library, to build it from source instead, such as a copy you're changing. Directory.Build.targets does the swap. -->
  <PropertyGroup Condition="'$(NovaFoldableRoot)' != ''">
    <NovaFoldableProject>$(NovaFoldableRoot)/src/Nova.Avalonia.Foldable/Nova.Avalonia.Foldable.csproj</NovaFoldableProject>
    <NovaFoldableSimulatorProject>$(NovaFoldableRoot)/src/Nova.Avalonia.Foldable.Simulator/Nova.Avalonia.Foldable.Simulator.csproj</NovaFoldableSimulatorProject>
  </PropertyGroup>
</Project>
